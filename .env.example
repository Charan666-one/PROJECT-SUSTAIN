# Copy to .env and fill in real values. Never commit the real .env.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=homoeo_dev
POSTGRES_USER=homoeo_admin
POSTGRES_PASSWORD=password

# Vector DB (Qdrant) — optional; app falls back to a local file store if absent
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_MATERIA_MEDICA=materia_medica
QDRANT_COLLECTION_CLINIC_CASES=clinic_cases
QDRANT_COLLECTION_DOCTOR_NOTES=doctor_notes

# LLM — optional; without a key the engine returns retrieved evidence instead of generation
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=2048

# Embeddings — optional; falls back to a hashing embedder if unavailable
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Voice (Whisper)
WHISPER_MODEL=medium

# WhatsApp Business API — optional; delivery is a graceful no-op if unset
WHATSAPP_API_URL=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# Redis / Celery
REDIS_URL=redis://localhost:6379

# Compliance
DATA_RETENTION_DAYS=2555
CONSENT_VERSION=1.0
